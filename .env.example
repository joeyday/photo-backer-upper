# Copy these into ~/.zshrc, or into ~/.config/photo-backer-upper/config (KEY=VALUE lines)
# for scheduled runs, since launchd doesn't read ~/.zshrc.

# Photos library to export from (optional; defaults to the system Photos library)
PHOTO_BACKER_UPPER_LIBRARY=

# Main backup location: any folder (local disk, external drive or network share). Must exist.
PHOTO_BACKER_UPPER_MAIN_DIR=/Volumes/Backup/Photos

# Optional secondary backup location, copied from the main one by `pback mirror`.
# Must have room for the whole backup.
PHOTO_BACKER_UPPER_SECONDARY_DIR=/Volumes/External/Photos

# Optional: if the main backup location is on a network share, its address, so pback can
# mount it when it isn't connected (e.g. smb://user@server/Share).
# Credentials come from the login Keychain (connect once in Finder and remember the password).
PHOTO_BACKER_UPPER_NAS_URL=
